# Additional local validation image for RTX 50-series hardware.
# The requested submission Dockerfile at the repository root remains 2.5.1.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
WORKDIR /pkg
COPY docker/requirements-runtime.txt /tmp/uwipl-requirements.txt
RUN pip install --no-cache-dir -r /tmp/uwipl-requirements.txt
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1
COPY . /pkg
ENV XDG_CACHE_HOME=/tmp/cache CUDA_CACHE_PATH=/tmp/cuda-cache TRITON_CACHE_DIR=/tmp/triton
